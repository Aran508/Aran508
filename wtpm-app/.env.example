# PostgreSQL connection (one central database for tablets and PCs)
DATABASE_URL=postgres://wtpm:wtpm@localhost:5432/wtpm
# Long random string used to sign login sessions (openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Folder where WTPM note photos are stored (outside the web root, back it up)
UPLOAD_DIR=./uploads
# Folder for pg_dump backups created by `npm run db:backup`
BACKUP_DIR=./backups
# Set to "true" only when the site is served over HTTPS
COOKIE_SECURE=false
# Initial administrator created by `npm run db:seed`
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=Admin@123
